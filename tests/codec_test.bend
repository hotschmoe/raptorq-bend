# End-to-end codec tests for src/raptorq.bend (docs/codec.md).
# Fixtures: tests/codec_fixtures.bend (generated by tools/gen_codec_test.py from tests/vectors and tests/vectors2).
# Run: bend tests/codec_test.bend   (or compile: bend tests/codec_test.bend -o ct && ./ct)
# Prints one line per group and ALL PASS; exits 1 (IO.die) on any failure.
#  1. encoder: every encoding symbol ESI 0..K+R-1 of tests/vectors/encoded.txt (and tests/vectors2) matches bit-exactly
#  2. decoder: every decode case of tests/vectors/decode.txt and tests/vectors2/decode.txt (ok=1 recovers the source,
#     ok=0 returns None)
#  3. API edge cases (invalid K, too few symbols), byte split/join
#  4. roundtrip properties on generated loss patterns: Some => equals the source bytes; None => the dense oracle
#     Solver.solve_dense also reports a rank-deficient matrix
import Base
import ../src/gf256.bend as G
import ../src/types.bend as Y
import ../src/tables.bend as T
import ../src/rfc_funcs.bend as R
import ../src/constraints.bend as C
import ../src/solver.bend as S
import ../src/raptorq.bend as Q
import ./codec_fixtures.bend as F

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

def band(a: Bool, b: Bool) -> Bool:
  match a:
    case True{}:
      b
    case False{}:
      False{}

def b2u(b: Bool) -> U32:
  match b:
    case True{}:
      1
    case False{}:
      0

def lst_eq(a: List<&2, U32>, b: List<&2, U32>) -> Bool:
  match a b:
    case Nil{} Nil{}:
      True{}
    case x <> xs y <> ys:
      band(U32.is_eq(x, y), lst_eq(xs, ys))
    case _ _:
      False{}

def veq(a: G.Vec, b: G.Vec) -> Bool:
  lst_eq(G.Vec.to_list(a, Nil{}), G.Vec.to_list(b, Nil{}))

def syms_eq(a: List<&2, G.Vec>, b: List<&2, G.Vec>) -> Bool:
  match a b:
    case Nil{} Nil{}:
      True{}
    case x <> xs y <> ys:
      band(veq(x, y), syms_eq(xs, ys))
    case _ _:
      False{}

def fail(b: Bool) -> U32:
  match b:
    case True{}:
      0
    case False{}:
      1

def lcg(+x: U32) -> U32:
  (x * 1664525 + 1013904223 : U32)

def sp_of.go(m: Maybe<&2, T.SP>) -> T.SP:
  match m:
    case Some{sp}:
      sp
    case None{}:
      T.SP{0, 0, 0, 0, 0, 0}

def sp_of(+k: U32) -> T.SP:
  sp_of.go(R.params(k))

# n symbols of tw words, in order
def split_syms(n: Nat, +tw: Nat, xs: List<&2, U32>, acc: List<&2, G.Vec>) -> List<&2, G.Vec>:
  match n:
    case 0n:
      List.reverse(&2, G.Vec, acc)
    case 1n+p:
      +ys = {xs : List<&2, U32>}
      split_syms(p, tw, List.drop(&2, U32, ys, tw), G.Vec.from_list(List.take(&2, U32, ys, tw)) <> acc)

# ---------------------------------------------------------------------------
# fixture cases
# ---------------------------------------------------------------------------

type Cs is Data:
  Cs{k: U32, t: U32, r: U32, syms: List<&2, G.Vec>, tr: C.ITree}

# [ncases] then per case [K, T, R, (K+R)*tw words]
def parse.go(n: Nat, xs: List<&2, U32>, acc: List<&2, Cs>) -> List<&2, Cs>:
  match n:
    case 0n:
      List.reverse(&2, Cs, acc)
    case 1n+p:
      match xs:
        case +k <> +t <> +r <> rest:
          +tw = U32.to_nat(U32.shrn((t + 3 : U32), 2n))
          +ns = (k + r : U32)
          +body = {rest : List<&2, U32>}
          +ss = split_syms(U32.to_nat(ns), tw, List.take(&2, U32, body, U32.to_nat((ns * U32.from_nat(tw) : U32))), Nil{})
          parse.go(p, List.drop(&2, U32, body, U32.to_nat((ns * U32.from_nat(tw) : U32))), Cs{k, t, r, ss, C.index(ss)} <> acc)
        case _:
          acc

def parse(xs: List<&2, U32>) -> List<&2, Cs>:
  match xs:
    case +n <> rest:
      parse.go(U32.to_nat(n), rest, Nil{})
    case _:
      Nil{}

def nth_case(xs: List<&2, Cs>, +i: U32) -> Cs:
  match xs:
    case Nil{}:
      Cs{0, 0, 0, Nil{}, C.INil{}}
    case Con{c, rest}:
      match i:
        case 0:
          c
        case _:
          nth_case(rest, (i - 1 : U32))

# ---------------------------------------------------------------------------
# 1. encoder
# ---------------------------------------------------------------------------

def enc.cmp(m: Maybe<&2, Q.Enc>, +n: U32, exp: List<&2, G.Vec>) -> U32:
  match m:
    case None{}:
      1
    case Some{e}:
      fail(syms_eq(Q.Codec.symbols(e, 0, n), exp))

def enc_case(c: Cs) -> U32:
  match c:
    case Cs{+k, +t, +r, +syms, tr}:
      enc.cmp(Q.Codec.encoder(k, t, List.take(&2, G.Vec, {syms : List<&2, G.Vec>}, U32.to_nat(k))), (k + r : U32), syms)

def enc_loop(cs: List<&2, Cs>, +i: U32, bad: U32, +tag: U32) -> IO(U32):
  match cs:
    case Nil{}:
      IO.pure(U32, bad)
    case Con{c, rest}:
      match c:
        case Cs{+k, +t, +r, +syms, tr}:
          +f = enc_case(Cs{k, t, r, syms, tr})
          do IO<U32>:
            IO.print("encoder set" ++ U32.show(tag) ++ " K=" ++ U32.show(k) ++ " T=" ++ U32.show(t) ++ " esi 0.." ++ U32.show((k + r - 1 : U32)) ++ ": " ++ U32.show(f))
            enc_loop(rest, (i + 1 : U32), (bad + f : U32), tag)

# ---------------------------------------------------------------------------
# 2. decoder on the golden decode cases
# ---------------------------------------------------------------------------

def rcv_of(es: List<&2, U32>, +tr: C.ITree) -> List<&2, Y.Rcv>:
  match es:
    case Nil{}:
      Nil{}
    case Con{+e, rest}:
      Y.Rcv{e, C.ix.get(tr, e, G.VNil{})} <> rcv_of(rest, tr)

def dec.cmp(res: Maybe<&2, List<&2, G.Vec>>, ok: U32, exp: List<&2, G.Vec>) -> U32:
  match res:
    case None{}:
      b2u(U32.is_eq(ok, 1))
    case Some{out}:
      match ok:
        case 1:
          fail(syms_eq(out, exp))
        case _:
          1

def oracle_none(m: Maybe<&2, List<&2, G.Vec>>) -> U32:
  match m:
    case None{}:
      1
    case Some{c}:
      3

# for ok=0 cases the dense oracle must also report a rank-deficient matrix (oracle_none = 1)
def dec_oracle(+ok: U32, +sp: T.SP, +t: U32, +k: U32, rv: List<&2, Y.Rcv>) -> U32:
  match ok:
    case 0:
      fail(U32.is_eq(oracle_none(S.Solver.solve_dense(R.L(sp), List.append(&2, Y.Row, C.fixed(sp, t), C.received_rows(sp, k, rv)))), 1))
    case _:
      0

def dec_case(c: Cs, +ok: U32, es: List<&2, U32>) -> U32:
  match c:
    case Cs{+k, +t, r, +syms, tr}:
      +rv = rcv_of(es, tr)
      (dec.cmp(Q.Codec.decode(k, t, rv), ok, List.take(&2, G.Vec, {syms : List<&2, G.Vec>}, U32.to_nat(k))) + dec_oracle(ok, sp_of(k), t, k, rv) : U32)

# [ndec] then per case [case, ok, nrecv, esis...]
def dec_loop(n: Nat, +i: U32, +cs: List<&2, Cs>, xs: List<&2, U32>, bad: U32, +tag: U32) -> IO(U32):
  match n:
    case 0n:
      IO.pure(U32, bad)
    case 1n+p:
      match xs:
        case +ci <> +ok <> +nr <> rest:
          +body = {rest : List<&2, U32>}
          +c = nth_case(cs, ci)
          +f = dec_case(c, ok, List.take(&2, U32, body, U32.to_nat(nr)))
          do IO<U32>:
            IO.print("decode set" ++ U32.show(tag) ++ " #" ++ U32.show(i) ++ " case " ++ U32.show(ci) ++ " nrecv=" ++ U32.show(nr) ++ " ok=" ++ U32.show(ok) ++ ": " ++ U32.show(f))
            dec_loop(p, (i + 1 : U32), cs, List.drop(&2, U32, body, U32.to_nat(nr)), (bad + f : U32), tag)
        case _:
          IO.pure(U32, (bad + 1 : U32))

def dec_run(cs: List<&2, Cs>, xs: List<&2, U32>, +tag: U32) -> IO(U32):
  match xs:
    case +n <> rest:
      dec_loop(U32.to_nat(n), 0, cs, rest, 0, tag)
    case _:
      IO.pure(U32, 1)

# ---------------------------------------------------------------------------
# 3. API edge cases, split / join
# ---------------------------------------------------------------------------

def is_none_enc(m: Maybe<&2, Q.Enc>) -> U32:
  match m:
    case None{}:
      0
    case Some{e}:
      1

def is_none_dec(m: Maybe<&2, List<&2, G.Vec>>) -> U32:
  match m:
    case None{}:
      0
    case Some{e}:
      1

def sym4(+x: U32) -> G.Vec:
  G.Vec.from_list([x])

# bytes (low 8 bits of the LCG high bits), n of them
def bytes.go(n: Nat, +x: U32, acc: List<&2, U32>) -> List<&2, U32>:
  match n:
    case 0n:
      acc
    case 1n+p:
      bytes.go(p, lcg(x), U32.shrn(lcg(x), 24n) <> acc)

def bytes_of(+n: U32, +seed: U32) -> List<&2, U32>:
  bytes.go(U32.to_nat(n), seed, [])

def len_sym(xs: List<&2, G.Vec>, +acc: U32) -> U32:
  match xs:
    case Nil{}:
      acc
    case Con{h, t}:
      len_sym(t, (acc + 1 : U32))

# split/join roundtrip: K = ceil(len/t), each symbol has ceil(t/4) words, join returns the data
def sj_case(+len: U32, +t: U32) -> U32:
  +d = bytes_of(len, (len * 31 + t : U32))
  +ss = Q.Codec.split(d, t)
  +k = len_sym(ss, 0)
  +exp_k = U32.max(1, ((len + t - 1) / t : U32))
  (fail(U32.is_eq(k, exp_k)) + fail(lst_eq(Q.Codec.join(ss, t, len), bytes_of(len, (len * 31 + t : U32)))) : U32)

def sj_loop(xs: List<&2, U32>, bad: U32) -> U32:
  match xs:
    case +len <> +t <> rest:
      sj_loop(rest, (bad + sj_case(len, t) : U32))
    case _:
      bad

def sj_cases() -> List<&2, U32>:
  [0, 4, 1, 4, 1, 1, 3, 4, 4, 4, 5, 4, 7, 4, 16, 16, 17, 16, 5, 5, 6, 5, 10, 5, 11, 5, 100, 7, 1001, 16, 1000, 4, 4096, 4, 33, 1, 9, 3]

# first symbol of a tiny known example: "AB" with T = 4 -> one word 0x41420000; "ABCDE", T = 2 -> 3 symbols
def sj_known.b(a: List<&2, G.Vec>, b: List<&2, G.Vec>) -> U32:
  match a b:
    case Con{h, tl} Con{h1, tl1}:
      (fail(lst_eq(G.Vec.to_list(h, Nil{}), [1094844416])) + fail(lst_eq(Q.Codec.sym_bytes(h1, 2), [65, 66])) + fail(U32.is_eq(len_sym(tl1, 0), 2)) : U32)
    case _ _:
      1

def sj_known() -> U32:
  sj_known.b(Q.Codec.split([65, 66], 4), Q.Codec.split([65, 66, 67, 68, 69], 2))

def edge_cases() -> U32:
  +one = {[sym4(1)] : List<&2, G.Vec>}
  (is_none_enc(Q.Codec.encoder(0, 4, [])) + is_none_enc(Q.Codec.encoder(3, 4, one)) + is_none_enc(Q.Codec.encoder(1, 0, one)) + is_none_enc(Q.Codec.encoder(56404, 4, one)) + is_none_dec(Q.Codec.decode(0, 4, [])) + is_none_dec(Q.Codec.decode(2, 4, [Y.Rcv{0, sym4(1)}])) + sj_loop(sj_cases(), 0) + sj_known() : U32)

# ---------------------------------------------------------------------------
# 4. roundtrip properties
# ---------------------------------------------------------------------------

type Cnt is Data:
  Cnt{ok: U32, none: U32, bad: U32}

def cnt_add(a: Cnt, code: U32) -> Cnt:
  match a:
    case Cnt{ok, none, bad}:
      match code:
        case 0:
          Cnt{(ok + 1 : U32), none, bad}
        case 1:
          Cnt{ok, (none + 1 : U32), bad}
        case _:
          Cnt{ok, none, (bad + 1 : U32)}

# Knuth selection sampling: choose `need` of the `left` values lo, lo+1, ...  (ascending), acc is reversed
def sel.acc(pick: Bool, +i: U32, acc: List<&2, U32>) -> List<&2, U32>:
  match pick:
    case True{}:
      i <> acc
    case False{}:
      acc

def sel.go(n: Nat, +i: U32, +left: U32, +need: U32, +x: U32, acc: List<&2, U32>) -> List<&2, U32>:
  match n:
    case 0n:
      acc
    case 1n+p:
      +x2 = lcg(x)
      +pick = U32.is_lt(((U32.shrn(x2, 8n)) % left : U32), need)
      sel.go(p, (i + 1 : U32), (left - 1 : U32), (need - b2u(pick) : U32), x2, sel.acc(pick, i, acc))

def select(+lo: U32, +m: U32, +n: U32, +seed: U32) -> List<&2, U32>:
  List.reverse(&2, U32, sel.go(U32.to_nat(m), lo, m, n, seed, []))

def rcv_enc(es: List<&2, U32>, +e: Q.Enc) -> List<&2, Y.Rcv>:
  match es:
    case Nil{}:
      Nil{}
    case Con{+x, rest}:
      Y.Rcv{x, Q.Codec.symbol(e, x)} <> rcv_enc(rest, e)

# code: 0 ok (Some, equals data), 1 None and the dense oracle agrees (rank deficient), 2 wrong data, 3 None but oracle solves
def judge(res: Maybe<&2, List<&2, G.Vec>>, +data: List<&2, U32>, +len: U32, +t: U32, +k: U32, +sp: T.SP, rv: List<&2, Y.Rcv>) -> U32:
  match res:
    case Some{out}:
      (2 * fail(lst_eq(Q.Codec.join(out, t, len), data)) : U32)
    case None{}:
      oracle_none(S.Solver.solve_dense(R.L(sp), List.append(&2, Y.Row, C.fixed(sp, t), C.received_rows(sp, k, rv))))

def one_pattern(+e: Q.Enc, +data: List<&2, U32>, +len: U32, +t: U32, +k: U32, +sp: T.SP, +i: U32) -> U32:
  +extra = (i .&. 3 : U32)
  +mode = (U32.shrn(i, 2n) .&. 1 : U32)
  +seed = lcg((i * 7919 + k * 65536 + t : U32))
  +rv = rcv_enc(select((k - k * mode : U32), (k + 10 + mode * U32.shr(k) : U32), (k + extra : U32), seed), e)
  judge(Q.Codec.decode(k, t, rv), data, len, t, k, sp, rv)

def patterns(n: Nat, +i: U32, +e: Q.Enc, +data: List<&2, U32>, +len: U32, +t: U32, +k: U32, +sp: T.SP, cn: Cnt) -> Cnt:
  match n:
    case 0n:
      cn
    case 1n+p:
      patterns(p, (i + 1 : U32), e, data, len, t, k, sp, cnt_add(cn, one_pattern(e, data, len, t, k, sp, i)))

def group.go(m: Maybe<&2, Q.Enc>, +data: List<&2, U32>, +len: U32, +t: U32, +k: U32, +reps: U32) -> Cnt:
  match m:
    case None{}:
      Cnt{0, 0, 1}
    case Some{e}:
      patterns(U32.to_nat((8 * reps : U32)), 0, e, data, len, t, k, sp_of(k), Cnt{0, 0, 0})

# K source symbols of T octets (the last one partially filled), 8*reps loss patterns
def group(+k: U32, +t: U32, +reps: U32) -> Cnt:
  +len = (k * t - U32.shr(t) : U32)
  +data = bytes_of(len, (k * 977 + t : U32))
  group.go(Q.Codec.encoder(k, t, Q.Codec.split(data, t)), data, len, t, k, reps)

def cnt_ok(c: Cnt) -> U32:
  match c:
    case Cnt{ok, none, bad}:
      ok

def cnt_none(c: Cnt) -> U32:
  match c:
    case Cnt{ok, none, bad}:
      none

def cnt_bad(c: Cnt) -> U32:
  match c:
    case Cnt{ok, none, bad}:
      bad

# [K, T, reps, ...]
def prop_loop(xs: List<&2, U32>, +ok: U32, +none: U32, +bad: U32) -> IO(U32):
  match xs:
    case +k <> +t <> +reps <> rest:
      do IO<U32>:
        +c : Cnt <- IO.pure(Cnt, group(k, t, reps))
        IO.print("roundtrip K=" ++ U32.show(k) ++ " T=" ++ U32.show(t) ++ ": decoded " ++ U32.show(cnt_ok(c)) ++ ", rank-deficient (oracle agrees) " ++ U32.show(cnt_none(c)) ++ ", BAD " ++ U32.show(cnt_bad(c)))
        prop_loop(rest, (ok + cnt_ok(c) : U32), (none + cnt_none(c) : U32), (bad + cnt_bad(c) : U32))
    case _:
      do IO<U32>:
        IO.print("roundtrip total: decoded " ++ U32.show(ok) ++ ", rank-deficient " ++ U32.show(none) ++ ", BAD " ++ U32.show(bad))
        IO.pure(U32, bad)

def prop_groups() -> List<&2, U32>:
  [1, 4, 3, 1, 5, 3, 2, 4, 20, 5, 4, 30, 10, 4, 40, 2, 16, 3, 3, 5, 3, 5, 16, 3, 8, 4, 3, 8, 5, 2, 10, 5, 3, 10, 16, 3, 16, 4, 3, 26, 4, 3, 26, 16, 3, 26, 5, 2, 50, 4, 2, 50, 16, 2, 100, 16, 1]

# ---------------------------------------------------------------------------

def finish(bad: U32) -> IO(Unit):
  match bad:
    case 0:
      IO.print("ALL PASS")
    case _:
      IO.die(Unit, 1, "FAILED: " ++ U32.show(bad))

def main() -> IO(Unit):
  do IO<Unit>:
    e1 : U32 <- enc_loop(parse(F.enc()), 0, 0, 1)
    e2 : U32 <- enc_loop(parse(F.enc2()), 0, 0, 2)
    d1 : U32 <- dec_run(parse(F.enc()), F.dec(), 1)
    d2 : U32 <- dec_run(parse(F.enc2()), F.dec2(), 2)
    +ed : U32 <- IO.pure(U32, edge_cases())
    IO.print("edge cases / split-join: " ++ U32.show(ed))
    p : U32 <- prop_loop(prop_groups(), 0, 0, 0)
    finish((e1 + e2 + d1 + d2 + ed + p : U32))
