# params() is None above K'max, Some below
def t_params_opt.go(m: Maybe<&2, T.SP>) -> U32:
  match m:
    case Some{+sp}:
      R.Kp(sp)
    case None{}:
      0

def t_params_opt() -> U32:
  (ck(t_params_opt.go(R.params(56403)), 56403) + ck(t_params_opt.go(R.params(56404)), 0) + ck(t_params_opt.go(R.params(0)), 10) + ck(t_params_opt.go(R.params(11)), 12) : U32)

