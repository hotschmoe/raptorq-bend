  match t:
    case R.Tup{+td, +ta, +tb, +td1, +ta1, +tb1}:
      (ck(td, d) + ck(ta, a) + ck(tb, b) + ck(td1, d1) + ck(ta1, a1) + ck(tb1, b1) : U32)

