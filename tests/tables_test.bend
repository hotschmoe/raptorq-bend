def main() -> IO(Unit):
  do IO<Unit>:
    +f0 : U32 = t_tables()
    IO.print(line("tables V0..V3 (hash of all 4x256 entries + spot values)", f0))
    +f1 : U32 = t_rand()
    IO.print(line("Rand (176 cases)", f1))
    +f2 : U32 = t_deg()
    IO.print(line("Deg (240 cases)", f2))
    +f3 : U32 = t_params()
    IO.print(line("K->K' + S,H,W,J,P1,L,P,U,B (38 K, + hash of all K in 0..56403)", f3))
    +f4 : U32 = t_params_opt()
    IO.print(line("params() Maybe", f4))
    +f5 : U32 = t_tuple_explicit()
    IO.print(line("Tuple explicit (89 values)", f5))
    +f6 : U32 = t_tuple_all_10()
    IO.print(line("Tuple K'=10, all X in 0..L-1 (hash)", f6))
    +f7 : U32 = t_tuple_all_12()
    IO.print(line("Tuple K'=12, all X in 0..L-1 (hash)", f7))
    +f8 : U32 = t_tuple_all_18()
    IO.print(line("Tuple K'=18, all X in 0..L-1 (hash)", f8))
    +f9 : U32 = t_tuple_all_20()
    IO.print(line("Tuple K'=20, all X in 0..L-1 (hash)", f9))
    +f10 : U32 = t_tuple_all_26()
    IO.print(line("Tuple K'=26, all X in 0..L-1 (hash)", f10))
    +f11 : U32 = t_tuple_all_30()
    IO.print(line("Tuple K'=30, all X in 0..L-1 (hash)", f11))
    +f12 : U32 = t_tuple_all_101()
    IO.print(line("Tuple K'=101, all X in 0..L-1 (hash)", f12))
    +f13 : U32 = t_tuple_all_257()
    IO.print(line("Tuple K'=257, all X in 0..L-1 (hash)", f13))
    +f14 : U32 = t_tuple_all_1002()
    IO.print(line("Tuple K'=1002, all X in 0..L-1 (hash)", f14))
    +f15 : U32 = t_tuple_all_4112()
    IO.print(line("Tuple K'=4112, all X in 0..L-1 (hash)", f15))
    +f16 : U32 = t_tuple_all_10017()
    IO.print(line("Tuple K'=10017, all X in 0..L-1 (hash)", f16))
    +f17 : U32 = t_tuple_all_56403()
    IO.print(line("Tuple K'=56403, all X in 0..L-1 (hash)", f17))
    done((f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10 + f11 + f12 + f13 + f14 + f15 + f16 + f17 : U32))
