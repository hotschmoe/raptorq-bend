# Tests for src/solver.bend on synthetic GF(256) systems (tests/solver_fixtures.bend, generated by
# tools/gen_solver_tests.py).  Run: bend tests/solver_test.bend
# Prints one line per system and ALL PASS; exits non-zero (IO.die) on any failure.
import Base
import ../src/gf256.bend as G
import ../src/types.bend as T
import ../src/solver.bend as S
import ./solver_fixtures.bend as F


# ---- stream reading -------------------------------------------------------------------------
def terms_of(n: Nat, xs: List<&2, U32>, acc: List<&2, T.Term>) -> List<&2, T.Term>:
  match n:
    case 0n:
      List.reverse(&2, T.Term, acc)
    case 1n+p:
      match xs:
        case c <> f <> rest:
          terms_of(p, rest, T.Term{c, f} <> acc)
        case _:
          Nil{}

def row_len(n: U32) -> Nat:
  U32.to_nat((2 * n + 3 : U32))   # nterms word + 2 per term + SYMW rhs words

def rhs_from(ys: List<&2, U32>) -> G.Vec:
  match ys:
    case w0 <> w1 <> _:
      G.Vec.from_list([w0, w1])
    case _:
      G.VNil{}

def rhs_of(n: Nat, xs: List<&2, U32>) -> G.Vec:
  rhs_from(List.drop(&2, U32, xs, n))

def row_of(xs: List<&2, U32>) -> T.Row:
  match xs:
    case +n <> rest:
      +rs = {rest : List<&2, U32>}
      T.Row{terms_of(U32.to_nat(n), rs, Nil{}), rhs_of(U32.to_nat((2 * n : U32)), rs)}
    case _:
      T.Row{Nil{}, G.VNil{}}

def after_row(xs: List<&2, U32>) -> List<&2, U32>:
  match xs:
    case +n <> rest:
      List.drop(&2, U32, rest, U32.to_nat((2 * n + 2 : U32)))
    case _:
      Nil{}

def rows_of(n: Nat, xs: List<&2, U32>, acc: List<T.Row>) -> List<T.Row>:
  match n:
    case 0n:
      List.reverse(&1, T.Row, acc)
    case 1n+p:
      +s = {xs : List<&2, U32>}
      rows_of(p, after_row(s), row_of(s) <> acc)

def after_rows(n: Nat, xs: List<&2, U32>) -> List<&2, U32>:
  match n:
    case 0n:
      xs
    case 1n+p:
      after_rows(p, after_row(xs))

# ---- comparison -----------------------------------------------------------------------------
def band(a: Bool, b: Bool) -> Bool:
  match a:
    case True{}:
      b
    case False{}:
      False{}

def flat(xs: List<G.Vec>) -> List<&2, U32>:
  match xs:
    case Nil{}:
      Nil{}
    case v <> rest:
      G.Vec.to_list(v, flat(rest))

def lst_eq(a: List<&2, U32>, b: List<&2, U32>) -> Bool:
  match a b:
    case Nil{} Nil{}:
      True{}
    case x <> xs y <> ys:
      band(U32.is_eq(x, y), lst_eq(xs, ys))
    case _ _:
      False{}

def fail(b: Bool) -> U32:
  match b:
    case True{}:
      0
    case False{}:
      1

# 0 = ok, 1 = wrong
def check(res: Maybe<List<G.Vec>>, +ex: U32, sol: List<&2, U32>) -> U32:
  match res:
    case None{}:
      fail(U32.is_eq(ex, 0))
    case Some{v}:
      match ex:
        case 0:
          1
        case _:
          fail(lst_eq(flat(v), sol))

# ---- one system -----------------------------------------------------------------------------
# returns failures: bit 0 = dense oracle wrong, bit 1 = inactivation solver wrong
def run_sys(+l: U32, +p: U32, nr: U32, +ex: U32, +body: List<&2, U32>) -> U32:
  +nrn = U32.to_nat(nr)
  +sol = List.take(&2, U32, after_rows(nrn, body), U32.to_nat((2 * l : U32)))
  a = check(S.Solver.solve_dense(l, rows_of(nrn, body, Nil{})), ex, sol)
  b = check(S.Solver.solve_p(l, p, rows_of(nrn, body, Nil{})), ex, sol)
  (a + 2 * b : U32)

def next_sys(+l: U32, nr: U32, ex: U32, body: List<&2, U32>) -> List<&2, U32>:
  match ex:
    case 0:
      after_rows(U32.to_nat(nr), body)
    case _:
      List.drop(&2, U32, after_rows(U32.to_nat(nr), body), U32.to_nat((2 * l : U32)))

def loop(n: Nat, +i: U32, xs: List<&2, U32>, bad: U32) -> IO(U32):
  match n:
    case 0n:
      IO.pure(U32, bad)
    case 1n+p:
      match xs:
        case +l <> +pp <> +nr <> +ex <> +body:
          +f = run_sys(l, pp, nr, ex, body)
          do IO<U32>:
            IO.print("system " ++ U32.show(i) ++ ": l=" ++ U32.show(l) ++ " rows=" ++ U32.show(nr) ++ " expect=" ++ U32.show(ex) ++ " -> " ++ U32.show(f))
            loop(p, (i + 1 : U32), next_sys(l, nr, ex, body), (bad + fail(U32.is_eq(f, 0)) : U32))
        case _:
          IO.pure(U32, bad)

def finish(bad: U32) -> IO(Unit):
  match bad:
    case 0:
      IO.print("ALL PASS")
    case _:
      IO.die(Unit, 1, "FAILED systems: " ++ U32.show(bad))

def run(xs: List<&2, U32>) -> IO(Unit):
  match xs:
    case +n <> rest:
      do IO<Unit>:
        bad : U32 <- loop(U32.to_nat(n), 0, rest, 0)
        finish(bad)
    case _:
      IO.print("empty fixtures")

def main() -> IO(Unit):
  run(F.fixtures())
