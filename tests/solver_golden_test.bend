# Golden test: solve the REAL RaptorQ systems built by src/constraints.bend (fixed rows + source rows) and
# compare the result with the RFC-conformant intermediate symbols in tests/vectors/intermediate.txt.
# Fixtures: tests/solver_golden_fixtures.bend (generated by tools/gen_solver_tests.py).
# Run: bend tests/solver_golden_test.bend     (prints one line per case and ALL PASS; exits 1 on failure)
# Cases: K in {1,2,10,26} x T in {16,32}, (50,16), (100,16), (500,4), (1000,4).
# Solver.solve_p (inactivation) is checked on every case, Solver.solve_dense (oracle) for K <= 100, and
# Solver.solve_par with d = 3 (symbols sliced into up to 8 word ranges: 4 slices for T=16, 8 for T=32) on every case.
# Plan / apply: Solver.plan on the real system, Solver.apply must give the RFC intermediate symbols bit for bit (also
# Solver.apply_par with d = 3), and the SAME plan applied to two other payloads (first word of every symbol, T = 4;
# every symbol followed by 3 * itself, T doubled) must give the correspondingly transformed intermediate symbols.
import Base
import ../src/gf256.bend as G
import ../src/types.bend as Y
import ../src/tables.bend as T
import ../src/rfc_funcs.bend as R
import ../src/constraints.bend as C
import ../src/solver.bend as S
import ./solver_golden_fixtures.bend as F

def sp_of.go(m: Maybe<&2, T.SP>) -> T.SP:
  match m:
    case Some{sp}:
      sp
    case None{}:
      T.SP{0, 0, 0, 0, 0, 0}

def sp_of(+k: U32) -> T.SP:
  sp_of.go(R.params(k))

def band(a: Bool, b: Bool) -> Bool:
  match a:
    case True{}:
      b
    case False{}:
      False{}

def lst_eq(a: List<&2, U32>, b: List<&2, U32>) -> Bool:
  match a b:
    case Nil{} Nil{}:
      True{}
    case x <> xs y <> ys:
      band(U32.is_eq(x, y), lst_eq(xs, ys))
    case _ _:
      False{}

def flat(xs: List<&2, G.Vec>) -> List<&2, U32>:
  match xs:
    case Nil{}:
      Nil{}
    case v <> rest:
      G.Vec.to_list(v, flat(rest))

def fail(b: Bool) -> U32:
  match b:
    case True{}:
      0
    case False{}:
      1

# n symbols of tw words each, in order
def split_syms(n: Nat, +tw: Nat, xs: List<&2, U32>, acc: List<&2, G.Vec>) -> List<&2, G.Vec>:
  match n:
    case 0n:
      List.reverse(&2, G.Vec, acc)
    case 1n+p:
      +ys = {xs : List<&2, U32>}
      split_syms(p, tw, List.drop(&2, U32, ys, tw), G.Vec.from_list(List.take(&2, U32, ys, tw)) <> acc)

def check(res: Maybe<&2, List<&2, G.Vec>>, expect: List<&2, U32>) -> U32:
  match res:
    case None{}:
      1
    case Some{c}:
      fail(lst_eq(flat(c), expect))

def rows_of(+sp: T.SP, +t: U32, +src: List<&2, G.Vec>) -> List<&2, Y.Row>:
  List.append(&2, Y.Row, C.fixed(sp, t), C.source_rows(sp, src))


# ---- plan / apply: payload variants (see the header) ---------------------------------------------------------
def first_word(ws: List<&2, U32>) -> G.Vec:
  match ws:
    case w <> _:
      G.Vec.from_list([w])
    case _:
      G.VNil{}

def first_all(vs: List<&2, G.Vec>) -> List<&2, G.Vec>:
  match vs:
    case Nil{}:
      Nil{}
    case v <> t:
      first_word(G.Vec.to_list(v, Nil{})) <> first_all(t)

def mul3(ws: List<&2, U32>) -> List<&2, U32>:
  match ws:
    case Nil{}:
      Nil{}
    case w <> t:
      G.mulw(3, w) <> mul3(t)

def cat3(+ws: List<&2, U32>) -> G.Vec:
  G.Vec.from_list(List.append(&2, U32, ws, mul3(ws)))

def cat3_all(vs: List<&2, G.Vec>) -> List<&2, G.Vec>:
  match vs:
    case Nil{}:
      Nil{}
    case v <> t:
      cat3(G.Vec.to_list(v, Nil{})) <> cat3_all(t)

def eqv(a: List<&2, G.Vec>, b: List<&2, G.Vec>) -> U32:
  fail(lst_eq(flat(a), flat(b)))

# bit0: apply wrong, bit1: apply_par(3) wrong, bit2: payload B wrong, bit3: payload C wrong
def plan_go(pl: Maybe<&2, S.Plan>, +rhs: List<&2, G.Vec>, +exp: List<&2, G.Vec>) -> U32:
  match pl:
    case None{}:
      15
    case Some{+plan}:
      a = eqv(S.Solver.apply(plan, rhs), exp)
      b = eqv(S.Solver.apply_par(3, plan, rhs), exp)
      c = eqv(S.Solver.apply(plan, first_all(rhs)), first_all(exp))
      d = eqv(S.Solver.apply(plan, cat3_all(rhs)), cat3_all(exp))
      (a + 2 * b + 4 * c + 8 * d : U32)

def plan_check(+sp: T.SP, +t: U32, +src: List<&2, G.Vec>, +tw: U32, exp: List<&2, U32>) -> U32:
  plan_go(S.Solver.plan(R.L(sp), R.P(sp), rows_of(sp, t, src)), S.rows_rhs(rows_of(sp, t, src), Nil{}), split_syms(U32.to_nat(R.L(sp)), U32.to_nat(tw), exp, Nil{}))

def dense_check.go(le: Bool, +sp: T.SP, +t: U32, +src: List<&2, G.Vec>, expect: List<&2, U32>) -> U32:
  match le:
    case True{}:
      check(S.Solver.solve_dense(R.L(sp), rows_of(sp, t, src)), expect)
    case False{}:
      0

def dense_check(+k: U32, sp: T.SP, t: U32, src: List<&2, G.Vec>, expect: List<&2, U32>) -> U32:
  dense_check.go(U32.is_le(k, 100), sp, t, src, expect)

# returns bit0 = inactivation solver wrong, bit1 = dense oracle wrong, bit2 = symbol-sliced solver wrong, bits 3-6 = plan_go
def run_case(+k: U32, +t: U32, +body: List<&2, U32>) -> U32:
  +sp = sp_of(k)
  +tw = U32.shrn(t, 2n)
  +src = split_syms(U32.to_nat(k), U32.to_nat(tw), body, Nil{})
  +exp = List.take(&2, U32, List.drop(&2, U32, body, U32.to_nat((k * tw : U32))), U32.to_nat((R.L(sp) * tw : U32)))
  a = check(S.Solver.solve_p(R.L(sp), R.P(sp), rows_of(sp, t, src)), exp)
  b = dense_check(k, sp, t, src, exp)
  c = check(S.Solver.solve_par(R.L(sp), R.P(sp), 3, rows_of(sp, t, src)), exp)
  d = plan_check(sp, t, src, tw, exp)
  (a + 2 * b + 4 * c + 8 * d : U32)

def next_case(+k: U32, +t: U32, body: List<&2, U32>) -> List<&2, U32>:
  List.drop(&2, U32, body, U32.to_nat(((k + R.L(sp_of(k))) * U32.shrn(t, 2n) : U32)))

def loop(n: Nat, +i: U32, xs: List<&2, U32>, bad: U32) -> IO(U32):
  match n:
    case 0n:
      IO.pure(U32, bad)
    case 1n+p:
      match xs:
        case +k <> +t <> +body:
          +f = run_case(k, t, body)
          do IO<U32>:
            IO.print("case " ++ U32.show(i) ++ ": K=" ++ U32.show(k) ++ " T=" ++ U32.show(t) ++ " -> " ++ U32.show(f))
            loop(p, (i + 1 : U32), next_case(k, t, body), (bad + fail(U32.is_eq(f, 0)) : U32))
        case _:
          IO.pure(U32, bad)

def finish(bad: U32) -> IO(Unit):
  match bad:
    case 0:
      IO.print("ALL PASS")
    case _:
      IO.die(Unit, 1, "FAILED cases: " ++ U32.show(bad))

def run(xs: List<&2, U32>) -> IO(Unit):
  match xs:
    case +n <> rest:
      do IO<Unit>:
        bad : U32 <- loop(U32.to_nat(n), 0, rest, 0)
        finish(bad)
    case _:
      IO.print("empty fixtures")

def main() -> IO(Unit):
  run(F.golden())
