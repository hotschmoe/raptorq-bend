  match b:
    case 0:
      0
    case _:
      oct_exp((oct_log(a) + oct_log(b) : U32))

def mul(+a: U32, +b: U32) -> U32:
  match a:
    case 0:
      0
    case _:
      mul.nz(a, b)

# u / v = 0 if u == 0, else OCT_EXP[OCT_LOG[u] - OCT_LOG[v] + 255].
# Division by zero is undefined in the RFC; here it returns 0.
def div.nz(+a: U32, +b: U32) -> U32:
  match b:
    case 0:
      0
    case _:
      oct_exp((oct_log(a) + 255 - oct_log(b) : U32))

def div(+a: U32, +b: U32) -> U32:
  match a:
    case 0:
      0
    case _:
      div.nz(a, b)

# Multiplicative inverse: OCT_EXP[255 - OCT_LOG[u]]; inv(0) = 0 (undefined).
def inv(+a: U32) -> U32:
  match a:
    case 0:
      0
    case _:
      oct_exp((255 - oct_log(a) : U32))

# alpha^^i = OCT_EXP[i], 0 <= i < 256 (we accept any i < 510).
def alpha_pow(i: U32) -> U32:
  oct_exp(i)

# Multiply by alpha (the octet 2), without tables: shift, reduce by 0x11D.
def xtime(+a: U32) -> U32:
  +s = U32.shln(a, 1n)
  m = (0 - U32.and(U32.shrn(s, 8n), 1) : U32)
  (s .^. U32.and(m, 285) : U32)

def mul_slow.go(n: Nat, +a: U32, +b: U32, acc: U32) -> U32:
  match n:
    case 0n:
      acc
    case 1n+p:
      m = (0 - U32.and(b, 1) : U32)
      mul_slow.go(p, xtime(a), U32.shrn(b, 1n), (acc .^. U32.and(m, a) : U32))

# Table-free carry-less multiply mod 0x11D. Used to cross-check the tables.
def mul_slow(a: U32, b: U32) -> U32:
  mul_slow.go(8n, a, b, 0)

# ---------------------------------------------------------------------------
# Packed words: 4 octets per U32, SWAR (SIMD within a register)
# ---------------------------------------------------------------------------

# alpha * w on all 4 octets at once.
def xtime4(+w: U32) -> U32:
  lo = U32.shln(U32.and(w, 2139062143), 1n)             # (w & 0x7f7f7f7f) << 1
  hi = (U32.and(U32.shrn(w, 7n), 16843009) * 29 : U32)  # ((w>>7) & 0x01010101) * 0x1d
  (lo .^. hi : U32)

def mulw.go(n: Nat, +c: U32, +w: U32, acc: U32) -> U32:
  match n:
    case 0n:
      acc
    case 1n+p:
      m = (0 - U32.and(c, 1) : U32)
      mulw.go(p, U32.shrn(c, 1n), xtime4(w), (acc .^. U32.and(m, w) : U32))

# c * w for an octet c and a packed word w (c * each octet of w).
def mulw(c: U32, w: U32) -> U32:
  mulw.go(8n, c, w, 0)

# ---------------------------------------------------------------------------
# Symbols: balanced trees of packed words (divide-and-conquer => parallel)
# ---------------------------------------------------------------------------

type Vec is Data:
  VNil{}
  VWord{w: U32}
  VNode{l: Vec, r: Vec}

# All binary vector ops zip two vectors of the SAME SHAPE. Vectors built by
# `Vec.from_list` from lists of equal length always have equal shape. On a
# shape mismatch the first argument's subtree is returned unchanged (totality).

def Vec.xor(a: Vec, b: Vec) -> Vec:
  match a b:
    case VNode{al, ar} VNode{bl, br}:
      l r = Vec.xor(al, bl) Vec.xor(ar, br)
      VNode{l, r}
    case VWord{x} VWord{y}:
      VWord{U32.xor(x, y)}
    case x _:
      x

# The zero vector of the same shape as v.
def Vec.zeros(v: Vec) -> Vec:
  match v:
    case VNode{l, r}:
      zl zr = Vec.zeros(l) Vec.zeros(r)
      VNode{zl, zr}
    case VWord{_}:
      VWord{0}
    case VNil{}:
      VNil{}

# c * v
def Vec.scale.go(+c: U32, v: Vec) -> Vec:
  match v:
    case VNode{vl, vr}:
      l r = Vec.scale.go(c, vl) Vec.scale.go(c, vr)
      VNode{l, r}
    case VWord{w}:
      VWord{mulw(c, w)}
    case VNil{}:
      VNil{}

def Vec.scale(c: U32, v: Vec) -> Vec:
  match c:
    case 0:
      Vec.zeros(v)
    case 1:
      v
    case _:
      Vec.scale.go(c, v)

# dst ^ c*src, fused in one traversal.
def Vec.muladd.go(+c: U32, dst: Vec, src: Vec) -> Vec:
  match dst src:
    case VNode{dl, dr} VNode{sl, sr}:
      l r = Vec.muladd.go(c, dl, sl) Vec.muladd.go(c, dr, sr)
      VNode{l, r}
    case VWord{x} VWord{y}:
      VWord{U32.xor(x, mulw(c, y))}
    case x _:
      x

# dst ^= c * src  (functional: returns the new dst)
def Vec.muladd(c: U32, dst: Vec, src: Vec) -> Vec:
  match c:
    case 0:
      dst
    case 1:
      Vec.xor(dst, src)
    case _:
      Vec.muladd.go(c, dst, src)

def Vec.to_list(v: Vec, acc: List<&2, U32>) -> List<&2, U32>:
  match v:
    case VNil{}:
      acc
    case VWord{w}:
      w <> acc
    case VNode{l, r}:
      Vec.to_list(l, Vec.to_list(r, acc))

# Build a balanced tree from the first c words of xs; fuel d bounds the depth
# (32 is plenty for a U32 count). Halves are built in parallel.
def Vec.build(+d: Nat, +c: U32, +xs: List<&2, U32>) -> Vec:
  match d:
    case 0n:
      VNil{}
    case 1n+p:
      match c:
        case 0:
          VNil{}
        case 1:
          match xs:
            case Nil{}:
              VNil{}
            case Con{h, t}:
              VWord{h}
        case _:
          +h = U32.shr(c)
          l r = Vec.build(p, h, List.take(&2, U32, xs, U32.to_nat(h))) Vec.build(p, (c - h : U32), List.drop(&2, U32, xs, U32.to_nat(h)))
          VNode{l, r}

# Build a balanced Vec from a list of packed words.
def Vec.from_list(+xs: List<&2, U32>) -> Vec:
  Vec.build(32n, U32.from_nat(List.length(&2, U32, xs)), xs)

# ===========================================================================
# Laws (LAWS-style claims, each followed by its proof)
# ===========================================================================
# Octet addition is U32.xor, which Base defines bitwise on Word(32n); we prove
# the group laws for XOR on Bool, then Word(n), then U32, then restate them for
# `add`. Field laws for `mul` are NOT proven (see docs/proofs.md); they are
# checked exhaustively by tests/gf256_test.bend instead.

law bool_xor_comm:
  for a: Bool
  for b: Bool
  {Bool.xor(a, b) == Bool.xor(b, a) : Bool}

def bool_xor_comm(a, b):
  match a b:
    case False{} False{}:
      {==}
    case False{} True{}:
      {==}
    case True{} False{}:
      {==}
    case True{} True{}:
      {==}

law word_xor_comm:
  for n: Nat
  for a: Word(n)
  for b: Word(n)
  {Word.xor(n, a, b) == Word.xor(n, b, a) : Word(n)}

def word_xor_comm(n, a, b):
  match n:
    case 0n:
      match a b:
        case WNil{} WNil{}:
          {==}
    case 1n+p:
      match a b:
        case WCon{False{}, at} WCon{False{}, bt}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w},
            Word.xor(p, at, bt), Word.xor(p, bt, at), word_xor_comm(p, at, bt))
        case WCon{False{}, at} WCon{True{}, bt}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{True{}, w},
            Word.xor(p, at, bt), Word.xor(p, bt, at), word_xor_comm(p, at, bt))
        case WCon{True{}, at} WCon{False{}, bt}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{True{}, w},
            Word.xor(p, at, bt), Word.xor(p, bt, at), word_xor_comm(p, at, bt))
        case WCon{True{}, at} WCon{True{}, bt}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w},
            Word.xor(p, at, bt), Word.xor(p, bt, at), word_xor_comm(p, at, bt))

law word_xor_self:
  for n: Nat
  for a: Word(n)
  {Word.xor(n, a, a) == Word.zero(n) : Word(n)}

def word_xor_self(n, a):
  match n:
    case 0n:
      match a:
        case WNil{}:
          {==}
    case 1n+p:
      match a:
        case WCon{False{}, at}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w},
            Word.xor(p, at, at), Word.zero(p), word_xor_self(p, at))
        case WCon{True{}, at}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w},
            Word.xor(p, at, at), Word.zero(p), word_xor_self(p, at))

law word_xor_zero:
  for n: Nat
  for a: Word(n)
  {Word.xor(n, a, Word.zero(n)) == a : Word(n)}

def word_xor_zero(n, a):
  match n:
    case 0n:
      match a:
        case WNil{}:
          {==}
    case 1n+p:
      match a:
        case WCon{False{}, at}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{False{}, w},
            Word.xor(p, at, Word.zero(p)), at, word_xor_zero(p, at))
        case WCon{True{}, at}:
          Equal.cong(Word(p), Word(1n+p), w => WCon{True{}, w},
            Word.xor(p, at, Word.zero(p)), at, word_xor_zero(p, at))

# add is commutative
law add_comm:
  for a: U32
  for b: U32
  {add(a, b) == add(b, a) : U32}

def add_comm(a, b):
  match a b:
    case U32{x} U32{y}:
      Equal.cong(Word(32n), U32, w => U32{w}, Word.xor(32n, x, y),
        Word.xor(32n, y, x), word_xor_comm(32n, x, y))

# every octet is its own additive inverse (characteristic 2)
law add_self:
  for a: U32
  {add(a, a) == 0 : U32}

def add_self(a):
  match a:
    case U32{x}:
      Equal.cong(Word(32n), U32, w => U32{w}, Word.xor(32n, x, x),
        Word.zero(32n), word_xor_self(32n, x))

# 0 is the additive identity
law add_zero:
  for a: U32
  {add(a, 0) == a : U32}

def add_zero(a):
  match a:
    case U32{x}:
      Equal.cong(Word(32n), U32, w => U32{w}, Word.xor(32n, x, Word.zero(32n)),
        x, word_xor_zero(32n, x))

# 0 annihilates under mul (left)
law mul_zero_l:
  for b: U32
  {mul(0, b) == 0 : U32}

def mul_zero_l(b):
  {==}

# 0 / b = 0
law div_zero_l:
  for b: U32
  {div(0, b) == 0 : U32}

def div_zero_l(b):
  {==}
